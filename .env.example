# ==============================================================================
# ScamCheck Environment Variables Example
# Copy to .env.local for local development. Never commit real secret keys.
# ==============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Phase 12: AI Analysis Provider (Optional)
# Leave empty to use built-in deterministic heuristic analysis
AI_API_KEY=
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Phase 13: Threat Intelligence Provider (Optional)
# Leave empty for standard passive RDAP domain analysis
THREAT_INTEL_API_KEY=
